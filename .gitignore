state/*.db
state/*.db-journal
state/*.db-wal
state/*.db-shm
state/*.sqlite
state/*.sqlite3

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- Scheduler poller logs ---
state/logs/

# --- Runtime watchdog debounce + scheduler heartbeat state (timestamps only) ---
state/telegram_watchdog.json
state/scheduler_watchdog.json
state/scheduler_loop_state.json

# --- Hy-Vee cart automation (local session + debug screenshot) ---
state/hyvee_session.json
scripts/hyvee/last_error.png
scripts/hyvee/_debug/
state/hyvee_tmp/

# --- Bun (installed by `bun install` in scripts/scheduler_channel/; bun.lock IS committed) ---
scripts/scheduler_channel/node_modules/

