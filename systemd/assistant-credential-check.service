[Unit]
Description=Scherbring assistant login-expiry check (Hy-Vee, Google Drive, Monarch)

[Service]
Type=oneshot
WorkingDirectory=@REPO_ROOT@
EnvironmentFile=-%h/.config/scherbring-assistant/.env
Environment=PATH=@REPO_ROOT@/.venv/bin:%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@REPO_ROOT@/.venv/bin/python @REPO_ROOT@/scripts/credential_check.py
# Headless Chromium probe for Hy-Vee plus two small checks.
TimeoutStartSec=240
