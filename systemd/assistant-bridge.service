[Unit]
Description=Scherbring assistant Telegram bridge (polls Telegram, durable inbox/outbox)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
EnvironmentFile=-%h/.config/scherbring-assistant/.env
Environment=PYTHONUNBUFFERED=1
# TEST phase uses TELEGRAM_TEST_BOT_TOKEN. At cutover: --token-env TELEGRAM_BOT_TOKEN.
ExecStart=@REPO_ROOT@/.venv/bin/python @REPO_ROOT@/scripts/telegram_bridge.py --token-env TELEGRAM_TEST_BOT_TOKEN
Restart=always
RestartSec=1

[Install]
WantedBy=default.target
