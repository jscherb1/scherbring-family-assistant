[Unit]
Description=Scherbring assistant scheduler tick (runs due scheduled tasks)

[Service]
Type=oneshot
WorkingDirectory=@REPO_ROOT@
EnvironmentFile=-%h/.config/scherbring-assistant/.env
# claude lives in ~/.local/bin; the venv first so child 'python' calls resolve to it.
Environment=PATH=@REPO_ROOT@/.venv/bin:%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@REPO_ROOT@/.venv/bin/python @REPO_ROOT@/scripts/scheduler_dispatch.py
# A tick runs claude tasks of up to 300 s each.
TimeoutStartSec=360
