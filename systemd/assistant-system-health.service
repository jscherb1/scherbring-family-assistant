[Unit]
Description=Scherbring assistant integration health checks (COROS, Open-Meteo, Drive, Monarch, Hy-Vee)

[Service]
Type=oneshot
WorkingDirectory=@REPO_ROOT@
EnvironmentFile=-%h/.config/scherbring-assistant/.env
Environment=PATH=@REPO_ROOT@/.venv/bin:%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@REPO_ROOT@/.venv/bin/python @REPO_ROOT@/scripts/system_health_store.py check
# Monarch probe up to 90 s, plus the Hy-Vee headless check (re-tested once if it says expired).
TimeoutStartSec=300
